{
  "manifest_version": 3,
  "name": "PDD Parser 采集助手",
  "version": "1.4.0",
  "minimum_chrome_version": "120",
  "description": "读取当前商品、预览确认后保存，提供异常诊断和字段来源记录；列表自动记录默认关闭。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PDD Parser 采集助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "activeTab", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.yangkeduo.com/mall_page.html*",
        "https://*.yangkeduo.com/pdd_mall.html*",
        "https://*.yangkeduo.com/search_result.html*",
        "https://*.yangkeduo.com/search.html*",
        "https://*.yangkeduo.com/mall/*",
        "https://*.yangkeduo.com/search*",
        "https://*.pinduoduo.com/mall_page.html*",
        "https://*.pinduoduo.com/pdd_mall.html*",
        "https://*.pinduoduo.com/search_result.html*",
        "https://*.pinduoduo.com/search.html*",
        "https://*.pinduoduo.com/mall/*",
        "https://*.pinduoduo.com/search*"
      ],
      "js": ["policy.js", "bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
